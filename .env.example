# Copy to .env for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Telegram
TELEGRAM_BOT_TOKEN=
# Any random string of letters, digits, _ or - (e.g. `openssl rand -hex 32`).
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs of the household.
ALLOWED_TELEGRAM_IDS=

# Supabase (Settings → API Keys / Data API)
SUPABASE_URL=
# The anon / publishable key. It is sent to the browser, which is fine.
SUPABASE_ANON_KEY=
# The service_role / secret key. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Set ONE of these two (see README → Supabase JWT):
SUPABASE_JWT_SECRET=
SUPABASE_JWT_PRIVATE_KEY=

# Optional: defaults to this deployment's URL on Vercel.
MINI_APP_URL=

# Assistant (Anthropic console → API Keys)
ANTHROPIC_API_KEY=
# A current Claude model id, e.g. claude-sonnet-5 — check Anthropic's docs for the latest.
CLAUDE_MODEL_MAIN=

# Later phases
CLAUDE_MODEL_FAST=
OPENAI_API_KEY=

# Local development only (npm run dev:initdata)
VITE_DEV_INIT_DATA=
